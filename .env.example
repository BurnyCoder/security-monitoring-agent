# Local defaults; actual .env is ignored by Git. Existing CLI logins are reused.
SMA_PROVIDER='codex'
SMA_MODEL='gpt-6-luna'
SMA_INTERVAL_MINUTES='60'
SMA_AUTO_SCAN='true'
SMA_NEWS_DAYS='7'
SMA_TIMEOUT_SECONDS='1800'
SMA_CODEX_PATH='codex'
SMA_CLAUDE_PATH='claude'
SMA_OSV_PATH='osv-scanner'
SMA_SCHEDULE_MODE='app'
# Omit SMA_PROJECT_ROOTS to scan only this workspace. Add explicit native paths in Settings.
